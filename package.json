{
  "name": "game-icon-export-app",
  "version": "1.0.9",
  "description": "游戏图标导出工具 - 把游戏 ICON 批量导出成直角/圆角规格的 PNG,按游戏名命名",
  "main": "main.js",
  "author": "Cindy User",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.gameicon.export",
    "productName": "GameIconExport",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "compress.js",
      "pngquant.js",
      "index.html",
      "renderer.js",
      "renderer.css"
    ],
    "extraResources": [
      {
        "from": "vendor/pngquant",
        "to": "pngquant"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "游戏图标导出"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png"
    },
    "dmg": {
      "title": "游戏图标导出 ${version}"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  }
}
